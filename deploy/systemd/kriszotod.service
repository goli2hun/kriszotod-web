[Unit]
Description=Krisz Ötödölő FastAPI
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/kriszotod
Environment="PATH=/opt/kriszotod/.venv/bin"
ExecStart=/opt/kriszotod/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8030
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
